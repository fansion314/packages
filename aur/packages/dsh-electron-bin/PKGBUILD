# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=dsh-electron-bin
pkgver=0.2.2rc.1
pkgrel=1
_version=0.2.2-rc.1
_tag=deepseek-harness-v0.2.2-rc.1-1
pkgdesc='DeepSeek Harness desktop using system Electron (prebuilt)'
arch=('x86_64')
url='https://github.com/fansion314/packages'
license=('MIT')
depends=('electron' 'libvips' 'python' 'python-numpy' 'python-pandas'
         'python-docx' 'python-pptx' 'python-openpyxl' 'python-pillow' 'python-lxml'
         'python-xlsxwriter' 'python-tzdata' 'python-dateutil' 'python-six'
         'python-typing_extensions' 'python-et-xmlfile' 'ripgrep' 'gcc-libs' 'glibc' 'xdg-utils' 'xdg-user-dirs')
provides=("dsh-electron=${pkgver}")
conflicts=('dsh-electron')
options=('!strip')
_package="dsh-electron-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source=("${url}/releases/download/${_tag}/${_package}")
noextract=("${_package}")
sha256sums=('18fa0b8fa6e3b73cf37aad19532e51e547281188d484cfe6b59a2638f2b2dc08')

package() {
  bsdtar -xf "$srcdir/$_package" -C "$pkgdir" usr
  chmod 755 "$pkgdir/usr/bin/dsh-desktop"
  mv "$pkgdir/usr/share/licenses/dsh-electron" "$pkgdir/usr/share/licenses/$pkgname"
}
