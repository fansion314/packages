# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=mygo-cloudmusic-bin
pkgver=0.1.20
pkgrel=2
_tag=mygo-cloudmusic-v0.1.20-2
pkgdesc='MyGo CloudMusic native NetEase Music client with adjustable interface scale (prebuilt Arch package)'
arch=('x86_64')
url='https://github.com/fansion314/packages'
license=('AGPL-3.0-only')
depends=('glibc' 'gtk3' 'libsecret' 'libpulse' 'alsa-lib' 'hicolor-icon-theme')
optdepends=('gnome-keyring: store login credentials' 'libayatana-appindicator: system tray integration')
provides=("mygo-cloudmusic=${pkgver}")
conflicts=('mygo-cloudmusic' 'mygo-cloudmusic-git')
options=('!strip')
_package="mygo-cloudmusic-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source=("${url}/releases/download/${_tag}/${_package}")
noextract=("${_package}")
sha256sums=('cc3376e4fb53e6c9ecd3a049508142a70d2e99d7bed05c3649bc974fa382e9f0')

package() {
  bsdtar -xf "$srcdir/$_package" -C "$pkgdir" usr
  mv "$pkgdir/usr/share/licenses/mygo-cloudmusic" "$pkgdir/usr/share/licenses/$pkgname"
}
