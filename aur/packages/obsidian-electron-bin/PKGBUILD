pkgname=obsidian-electron-bin
pkgver=1.14.5
pkgrel=1
pkgdesc='Obsidian with the latest system Electron (prebuilt GitHub release)'
arch=('x86_64')
url='https://github.com/fansion314/packages'
license=('LicenseRef-Obsidian')
depends=('bash' 'electron' 'fontconfig' 'zlib' 'hicolor-icon-theme')
provides=("obsidian=${pkgver}" "obsidian-electron=${pkgver}")
conflicts=('obsidian' 'obsidian-electron')
options=('!strip' '!debug')

# This pacman package is built by GitHub Actions from the sibling recipe.
_package="obsidian-electron-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source_x86_64=("https://github.com/fansion314/packages/releases/download/obsidian-v1.14.5-1/${_package}")
noextract=("${_package}")
sha256sums_x86_64=('3a3b74fc9fa83e2f5ee59e7eb861dcaaa7084c9d0822dbb1b9efb2aceb442f74')

package() {
    bsdtar -xf "$srcdir/$_package" -C "$pkgdir" usr
    mv "$pkgdir/usr/share/licenses/obsidian-electron" \
        "$pkgdir/usr/share/licenses/$pkgname"
}
