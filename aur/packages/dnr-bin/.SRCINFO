	optdepends = gtk3: native desktop UI for the CEF backend
	optdepends = webkit2gtk-4.1: WebView desktop backend (auto fallback)
	optdepends = libayatana-appindicator: system tray support
	optdepends = libnotify: desktop notifications via notify-send
	provides = dnr=0.5.6
	conflicts = dnr
	conflicts = dnr-cef
	conflicts = dnr-cef-bin
	conflicts = dnr-webview
	conflicts = dnr-webview-bin
