# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=motrix-electron-bin
pkgver=2.4.1
pkgrel=1
_version=2.4.1
_tag=motrix-v2.4.1-1
pkgdesc='Motrix download manager using system Electron (prebuilt Arch package)'
arch=('x86_64')
url='https://github.com/fansion314/packages'
license=('MIT' 'GPL-2.0-or-later')
depends=('electron' 'gcc-libs' 'glibc' 'xdg-utils')
optdepends=('libayatana-appindicator: system tray integration' 'ffmpeg: media downloads')
provides=("motrix=${pkgver}" "motrix2=${pkgver}" "motrix-electron=${pkgver}")
conflicts=('motrix' 'motrix-bin' 'motrix-git' 'motrix-beta-bin' 'motrix2' 'motrix2-bin' 'motrix-electron')
options=('!strip')
_package="motrix-electron-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source=("${url}/releases/download/${_tag}/${_package}")
noextract=("${_package}")
# Replaced with the verified release digest by arch-release.yml.
sha256sums=('2f84b1231bb09e8211cf4c21010228f0bcf4749c87eb86f75d8bbf7b35c95084')

package() {
  bsdtar -xf "$srcdir/$_package" -C "$pkgdir" usr
  mv "$pkgdir/usr/share/licenses/motrix-electron" "$pkgdir/usr/share/licenses/$pkgname"
}
