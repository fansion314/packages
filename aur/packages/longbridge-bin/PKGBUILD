# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=longbridge-bin
pkgver=1.1.0
pkgrel=1
_tag=longbridge-v1.1.0-1
pkgdesc='Longbridge trading platform desktop application (prebuilt Arch package)'
arch=('x86_64')
url='https://github.com/fansion314/packages'
license=('LicenseRef-proprietary')
depends=('glibc>=2.39' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'libsoup3' 'glib2' 'libxcb' 'alsa-lib' 'libxkbcommon' 'libxkbcommon-x11' 'openssl' 'sqlite' 'xz' 'vulkan-icd-loader' 'libglvnd' 'hicolor-icon-theme' 'xdg-utils')
optdepends=('vulkan-driver: GPU rendering' 'noto-fonts-cjk: Chinese text rendering' 'org.freedesktop.secrets: secure credential storage')
provides=("longbridge=${pkgver}")
conflicts=('longbridge' 'longbridge-desktop')
options=('!strip' '!debug')
_package="longbridge-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source=("${url}/releases/download/${_tag}/${_package}")
noextract=("${_package}")
sha256sums=('eeb57d05978cd0a9b673e72f50dae4d2402e7aa7315c29ae1a79d7c915ba086c')

package() {
  bsdtar -xf "$srcdir/$_package" -C "$pkgdir" usr
}
