export LANG=C.UTF-8 LC_ALL=C.UTF-8

pkgname=mihomomo
pkgver=1.19.33
pkgrel=3
pkgdesc='Mihomo-based proxy core for Clash Momo'
arch=('x86_64')
url='https://github.com/fansion314/momo'
license=('GPL-3.0-only')
depends=('glibc' 'libcap')
makedepends=('git' 'go' 'python')
install=mihomomo.install
source=("git+https://github.com/fansion314/momo.git#commit=1baac3bbd2099ccc41aeba9f25c07f8ffd116ec7" 'mihomomo.install')
sha256sums=('SKIP' 'b2eed56f6feafc8291adc22059ce37f27bb14464ae5b5bafa014acd85c8e02e6')
options=('!debug' '!strip')

build() {
  cd "$srcdir/momo"
  CGO_ENABLED=0 GOAMD64=v1 bash packaging/build-core.sh mihomomo "$pkgver"
}

check() {
  "$srcdir/momo/mihomomo" -v | grep -F "$pkgver"
  printf '%s' '{}' | "$srcdir/momo/mihomomo" tizi --state-dir "$srcdir/tizi-capability-check" status | python3 -c \
    'import json,sys;v=json.load(sys.stdin);assert v["ok"] and v["data"]["supported"] and v["data"]["keyReady"] and v["data"].get("managed_config_version",0)>=2'
}

package() {
  install -Dm755 "$srcdir/momo/mihomomo" "$pkgdir/usr/bin/mihomomo"
  install -Dm644 "$srcdir/momo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
