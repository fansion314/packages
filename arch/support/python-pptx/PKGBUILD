pkgname=python-pptx
pkgver=1.0.2
pkgrel=1
pkgdesc='Create and modify PowerPoint files with Python'
arch=('any')
url='https://github.com/scanny/python-pptx'
license=('MIT')
depends=('python' 'python-pillow' 'python-xlsxwriter' 'python-lxml' 'python-typing_extensions')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/52/a9/0c0db8d37b2b8a645666f7fd8accea4c6224e013c42b1d5c17c93590cd06/python_pptx-$pkgver.tar.gz")
sha256sums=('479a8af0eaf0f0d76b6f00b0887732874ad2e3188230315290cd1f9dd9cc7095')

build() {
  cd "python_pptx-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "python_pptx-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
