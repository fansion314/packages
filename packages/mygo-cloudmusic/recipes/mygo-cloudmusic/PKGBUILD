# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=mygo-cloudmusic
pkgver=@PKGVER@
pkgrel=@PKGREL@
_tag=@TAG@
pkgdesc='MyGo CloudMusic native NetEase Music client with adjustable interface scale'
arch=('x86_64')
url='https://github.com/@REPOSITORY@'
license=('AGPL-3.0-only')
depends=('glibc' 'gtk3' 'libsecret' 'libpulse' 'alsa-lib')
optdepends=('gnome-keyring: store login credentials' 'libayatana-appindicator: system tray integration')
makedepends=('git' 'go>=1.27.3' 'python' 'desktop-file-utils')
conflicts=('mygo-cloudmusic-bin' 'mygo-cloudmusic-git')
options=('!lto')
_packaging_ref='@PACKAGING_REF@'
source=("mygo-cloudmusic::git+https://github.com/egoist/mygo-cloudmusic.git#commit=@UPSTREAM_COMMIT@"
        "packaging::git+https://github.com/@REPOSITORY@.git#${_packaging_ref}")
sha256sums=('SKIP' 'SKIP')

prepare() {
  python "$srcdir/packaging/scripts/package.py" apply mygo-cloudmusic "$srcdir/mygo-cloudmusic"
}

build() {
  cd mygo-cloudmusic
  # Same identity and production UI as upstream; no upstream self-update feed.
  CGO_ENABLED=0 go build -mod=readonly -trimpath -tags mygo_noinspector \
    -ldflags "-s -w -X 'github.com/egoist/mygo.packageName=MyGo 云音乐' -X github.com/egoist/mygo.packageVersion=$pkgver -X github.com/egoist/mygo.packageIdentifier=dev.egoist.cloudmusic -X github.com/egoist/mygo.production=1" \
    -o mygo-cloudmusic .
}

check() {
  cd mygo-cloudmusic
  go test -mod=readonly ./internal/...
  go test -mod=readonly ./internal/app -run '^TestInterfaceScale' -count=5
  desktop-file-validate "$srcdir/packaging/packages/mygo-cloudmusic/mygo-cloudmusic.desktop"
}

package() {
  install -Dm755 mygo-cloudmusic/mygo-cloudmusic "$pkgdir/usr/bin/mygo-cloudmusic"
  install -Dm644 "$srcdir/packaging/packages/mygo-cloudmusic/mygo-cloudmusic.desktop" "$pkgdir/usr/share/applications/dev.egoist.cloudmusic.desktop"
  install -Dm644 mygo-cloudmusic/resources/icon.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/mygo-cloudmusic.png"
  install -Dm644 mygo-cloudmusic/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
