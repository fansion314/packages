diff --git a/internal/app/interface_scale_test.go b/internal/app/interface_scale_test.go
new file mode 100644
index 0000000..57fa9fe
--- /dev/null
+++ b/internal/app/interface_scale_test.go
@@ -0,0 +1,65 @@
+package app
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+)
+
+// Selecting a scale zooms both views and persists the choice for the next launch.
+func TestInterfaceScaleSelection(t *testing.T) {
+	a := newTestApp()
+	a.settings = defaultSettings()
+	a.settings.path = filepath.Join(t.TempDir(), "settings.json")
+	var settingsZoom float32
+	tt := ui.NewTester(func(c *ui.Context) {
+		a.settingsView(c)
+		settingsZoom = c.Zoom()
+	}, 560, 2400)
+	tt.Frame()
+	if err := tt.Click("缩放比例"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Key(0, ui.KeyEnd)
+	tt.Key(0, ui.KeyEnter)
+	tt.Frame()
+	if a.settings.InterfaceScale != 2 || settingsZoom != 2 {
+		t.Fatalf("selection %v, settings zoom %v", a.settings.InterfaceScale, settingsZoom)
+	}
+	b, err := os.ReadFile(a.settings.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var restored settings
+	if err := json.Unmarshal(b, &restored); err != nil {
+		t.Fatal(err)
+	}
+	a.settings = restored
+	var mainZoom float32
+	main := ui.NewTester(func(c *ui.Context) {
+		a.view(c)
+		mainZoom = c.Zoom()
+	}, 1180, 780)
+	main.Frame()
+	if mainZoom != 2 {
+		t.Fatalf("restored main zoom %v", mainZoom)
+	}
+}
+
+// Old settings and corrupt scale values must not make the interface inaccessible.
+func TestInterfaceScaleValidation(t *testing.T) {
+	for _, scale := range []float32{0, -1, 0.5, 3, float32(math.NaN()), float32(math.Inf(1))} {
+		if got := validInterfaceScale(scale); got != 1 {
+			t.Errorf("invalid %v became %v", scale, got)
+		}
+	}
+	for _, scale := range []float32{0.75, 1, 1.25, 2} {
+		if got := validInterfaceScale(scale); got != scale {
+			t.Errorf("valid %v became %v", scale, got)
+		}
+	}
+}
