@@ -0,0 +1,87 @@
+package app
+
+import (
+	"math"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/ui"
+
+	"mygo-music/internal/i18n"
+)
+
+// Selecting a scale in either language zooms both views and survives a restart.
+func TestInterfaceScaleSelection(t *testing.T) {
+	language := i18n.Language()
+	defer i18n.SetLanguage(language)
+	original, err := mygo.App.Path(mygo.PathUserData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer mygo.App.SetPath(mygo.PathUserData, original)
+	for _, language := range []string{i18n.English, i18n.Chinese} {
+		t.Run(language, func(t *testing.T) {
+			i18n.SetLanguage(language)
+			mygo.App.SetPath(mygo.PathUserData, t.TempDir())
+			a := newTestApp()
+			a.settings = loadSettings()
+			var settingsZoom float32
+			tt := ui.NewTester(func(c *ui.Context) {
+				a.settingsView(c)
+				settingsZoom = c.Zoom()
+			}, 1600, 1600)
+			tt.Frame()
+			if err := tt.Click(T("Scale")); err != nil {
+				t.Fatal(err)
+			}
+			tt.Key(0, ui.KeyEnd)
+			tt.Key(0, ui.KeyEnter)
+			tt.Frame()
+			if a.settings.InterfaceScale != 2 || settingsZoom != 2 {
+				t.Fatalf("selection %v, settings zoom %v", a.settings.InterfaceScale, settingsZoom)
+			}
+			restored := newTestApp()
+			restored.settings = loadSettings()
+			var mainZoom float32
+			main := ui.NewTester(func(c *ui.Context) {
+				restored.view(c)
+				mainZoom = c.Zoom()
+			}, 1600, 1600)
+			main.Frame()
+			if mainZoom != 2 {
+				t.Fatalf("restored main zoom %v", mainZoom)
+			}
+		})
+	}
+}
+
+// Missing and invalid saved scales keep the interface accessible when loaded.
+func TestInterfaceScaleValidation(t *testing.T) {
+	original, err := mygo.App.Path(mygo.PathUserData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer mygo.App.SetPath(mygo.PathUserData, original)
+	dir := t.TempDir()
+	mygo.App.SetPath(mygo.PathUserData, dir)
+	for _, text := range []string{"{}", `{"interfaceScale":0}`, `{"interfaceScale":-1}`, `{"interfaceScale":0.5}`, `{"interfaceScale":3}`} {
+		if err := os.WriteFile(filepath.Join(dir, "settings.json"), []byte(text), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if got := loadSettings().InterfaceScale; got != 1 {
+			t.Errorf("%s loaded as %v", text, got)
+		}
+	}
+	for _, scale := range []float32{float32(math.NaN()), float32(math.Inf(1))} {
+		if got := validInterfaceScale(scale); got != 1 {
+			t.Errorf("invalid %v became %v", scale, got)
+		}
+	}
+	for _, scale := range interfaceScales {
+		if got := validInterfaceScale(scale.value); got != scale.value {
+			t.Errorf("valid %v became %v", scale.value, got)
+		}
+	}
+}
