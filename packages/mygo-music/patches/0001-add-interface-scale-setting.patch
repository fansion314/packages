+// validInterfaceScale keeps old settings and invalid values usable.
+func validInterfaceScale(scale float32) float32 {
+	if math.IsNaN(float64(scale)) || math.IsInf(float64(scale), 0) || scale < 0.75 || scale > 2 {
+		return 1
+	}
+	return scale
+}
